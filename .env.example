APP_ENV=development
DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:5432/app_db
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MODEL=gpt-5.4-mini
OPENAI_INTAKE_MODEL=gpt-5.6
OPENAI_EVALUATION_ACTOR_MODEL=gpt-5.4-mini
INTAKE_REASONING_EFFORT=high
INTAKE_MAX_FOLLOW_UPS=4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LEGAL_RAG_MODEL=gpt-5.4-mini
LEGAL_RAG_REASONING_EFFORT=medium
LEGAL_RAG_EMBEDDING_MODEL=text-embedding-3-large
LEGAL_RAG_EMBEDDING_DIMENSIONS=1536
LEGAL_RAG_TOP_K=8
LEGAL_RAG_CANDIDATE_K=40
LEGAL_RAG_CHUNK_TOKENS=512
LEGAL_RAG_CHUNK_OVERLAP_TOKENS=77
LEGAL_RAG_MIN_SEMANTIC_SCORE=0.25
LEGAL_RAG_MIN_LEXICAL_SCORE=0.08
# LEGAL_RAG_CORPUS_PATH=/absolute/path/to/backend/corpus/legal
# Cero usa el catálogo versionado en app/costs.py; un valor positivo lo reemplaza.
# Revise el catálogo cuando cambien modelos o precios del proveedor.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
EMBEDDING_COST_PER_MILLION=0
AGENT_MAX_STEPS=4
TOOL_TRANSPORT=local
SIMILARITY_THRESHOLD=0.78
CLUSTER_TIME_WINDOW_DAYS=30
CLUSTER_CANDIDATE_K=200
# En producción se activa obligatoriamente; en local puede permanecer false.
REQUIRE_ADMIN_AUTH=false
# Compatibilidad temporal para integraciones antiguas; el frontend utiliza usuarios/sesiones.
ADMIN_API_KEY=
AUTH_SESSION_TTL_HOURS=8
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
