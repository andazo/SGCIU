{
  "displayName": "SGCIU - aumento de coste IA",
  "combiner": "OR",
  "enabled": true,
  "documentation": {
    "content": "El percentil 99 del coste de una operación de IA superó USD 0,25 durante una hora. Revise tokens por funcionalidad, posibles reintentos y modelos activos.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "application": "sgciu",
    "severity": "warning"
  },
  "conditions": [
    {
      "displayName": "p99 mayor a USD 0,25 por operación",
      "conditionThreshold": {
        "filter": "resource.type = \"cloud_run_revision\" AND resource.labels.service_name = \"sgciu-backend\" AND metric.type = \"logging.googleapis.com/user/sgciu_ai_estimated_cost_usd\"",
        "aggregations": [
          {
            "alignmentPeriod": "3600s",
            "perSeriesAligner": "ALIGN_PERCENTILE_99",
            "crossSeriesReducer": "REDUCE_MAX"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.25,
        "duration": "0s",
        "trigger": {"count": 1}
      }
    }
  ]
}
